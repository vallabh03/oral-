# Copy to .env.local for development. Never commit real values.
# Only variables prefixed NEXT_PUBLIC_ reach the browser — keep them non-secret.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Search indexing stays OFF (noindex + robots Disallow + review banner) until content is approved.
INDEXING_ENABLED=false
# Public photo gallery page (/gallery). Off until the programme approves the photos.
GALLERY_ENABLED=false
# Number of trusted proxies that append to X-Forwarded-For (CloudFront/Amplify = 1).
TRUSTED_PROXY_HOPS=1

# Database: leave DATABASE_URL empty to use embedded PGlite (dev/test only).
# Production: RDS PostgreSQL via RDS Proxy, credentials from AWS Secrets Manager.
DATABASE_URL=
PGLITE_DIR=.data/pglite
DB_POOL_MAX=10

# Photo/blob storage: db | local | s3   (production: s3)
STORAGE_DRIVER=db
LOCAL_STORAGE_DIR=.data/objects
S3_BUCKET=
S3_KMS_KEY_ID=
AWS_REGION=ap-south-2
PHOTO_MAX_UPLOAD_BYTES=3145728
PHOTO_PROCESS_CONCURRENCY=
PHOTO_QUEUE_LIMIT=200

# Secrets (production: AWS Secrets Manager). Must be >= 32 random characters.
AUDIT_HMAC_SECRET=
DATA_ENCRYPTION_KEY=

# Staff sign-in
AUTH_PASSWORD_ENABLED=true
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# Governance gate: participant intake stays closed in production until approved.
INTAKE_ENABLED=true
PARTICIPANT_ID_PREFIX=HAOC-DS

# Email: console | ses
EMAIL_DRIVER=console
SES_REGION=
EMAIL_FROM=no-reply@example.org
CONTACT_TO_EMAIL=programme@example.org

# Optional WhatsApp Cloud API (disabled unless all set)
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Oral lesion images (PRD v1.2). Keep false for live patient data until approved.
CLINICAL_IMAGES_ENABLED=false
CLINICAL_IMAGE_MAX_BYTES=15728640
# Separate private bucket + KMS key for clinical images (production)
CLINICAL_S3_BUCKET=
CLINICAL_S3_KMS_KEY_ID=

# Virtual screening: patient-captured mouth photos + remote doctor review. Keep false for live data until approved.
VIRTUAL_SCREENING_ENABLED=false
# Pilot bridge before WhatsApp approval: run virtual screening with NO patient messages (returning
# participants cannot log in with a code; doctors phone every result). Production refuses
# VIRTUAL_SCREENING_ENABLED=true with NOTIFY_DRIVER=console unless this is true.
VIRTUAL_SCREENING_WITHOUT_MESSAGING=false
# Patient messages: console (nothing is sent; local/test), whatsapp (Meta Cloud API, needs WHATSAPP_* above)
# or leminai (LeminAi Wrapper API, needs LEMINAI_* below). Template names and variables are the same for both.
NOTIFY_DRIVER=console
LEMINAI_API_KEY=
LEMINAI_BASE_URL=https://app.leminai.com
# WhatsApp login codes for returning participants. Set false until the login_code (authentication)
# template is approved; result messages still go out.
LOGIN_CODES_ENABLED=true
# Participant translations switched on after native-speaker + programme approval, e.g. te,hi,ur.
# Reviewers can see all drafts at /register?preview=translations.
TRANSLATIONS_ENABLED=
# Unreviewed translations shown to participants as drafts, with the English consent wording beside them:
# "all" or a list such as ta,kn. Approved languages in TRANSLATIONS_ENABLED take precedence.
TRANSLATIONS_DRAFT_LIVE=
NOTIFY_CLINIC_NAME=Telangana Against Oral Cancer
NOTIFY_CLINIC_PHONE=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en
