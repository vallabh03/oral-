STAFF_ACCESS_ENABLED=false
# Live data intake remains disabled until organizational review.
LIVE_INTAKE_ENABLED=false
PUBLIC_INTAKE_ENABLED=false
ADMIN_EMAIL=
# Comma-separated additional Super Admin emails. Keep this in the hosting runtime, not source control.
ADMIN_EMAILS=
# Comma-separated Doctor Admin emails provisioned on their first sign-in.
DOCTOR_ADMIN_EMAILS=
AUDIT_KEY=
# Final, reviewed participant privacy notice. Do not enable public intake without it.
PRIVACY_NOTICE=
CONSENT_VERSION=
# Public programme contact shown on the landing page (leave blank until approved).
CONTACT_EMAIL=
CONTACT_PHONE=
# WhatsApp Business Cloud API. Use a secret binding for the access token.
# Enable only after the document-header template, consent text and clinical report are approved.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_REPORT_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_VERSION=
