{
  "name": "taoc-drive-safe-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telangana Against Oral Cancer — DRIVE SAFE screening & programme operations platform",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/migrate.ts",
    "seed:dev": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed-dev.ts",
    "admin:create": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/create-super-admin.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "test:regression": "npm run typecheck && vitest run && playwright test",
    "audit:seo": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seo-audit.ts",
    "audit:secrets": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/secret-scan.ts",
    "load:photos": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/load-test-photos.ts",
    "assets": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/generate-assets.ts",
    "e2e:prepare": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/e2e-prepare.ts",
    "whatsapp:verify-token": "tsx --env-file-if-exists=.env.local scripts/whatsapp-verify-token.ts",
    "staff:create": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/create-staff.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/client-sesv2": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1157.0",
    "@electric-sql/pglite": "0.5.11",
    "@node-rs/argon2": "2.2.2",
    "jose": "6.2.13",
    "next": "16.4.3",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "undici": "8.12.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "postcss": "8.5.31"
  }
}
